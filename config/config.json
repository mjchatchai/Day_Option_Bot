{
  "bot_name": "Day Option (Bot Option Daytrade)",
  "version": "2.0.0",
  "watchlist": {
    "etf_index": [
      "SPY",
      "QQQ"
    ],
    "golden_stocks": [
      "AMD",
      "PLTR",
      "META",
      "NVDA",
      "AAPL",
      "AMZN"
    ]
  },
  "strategy_rules": {
    "trend_timeframe": "2m",
    "entry_timeframe": "30s",
    "ema_period": 200,
    "fibo_levels_enabled": [
      0.5,
      0.618
    ],
    "smart_fibo_routing": {
      "etf_primary_level": 0.5,
      "stock_primary_level": 0.618,
      "allow_secondary_with_high_rvol": true,
      "secondary_min_rvol": 1.5
    },
    "volume_filter": {
      "enabled": true,
      "vol_ma_period": 20,
      "min_rvol": 1.15
    },
    "gap_filter": {
      "enabled": true,
      "max_morning_gap_pct": 2.0
    },
    "earnings_filter": {
      "enabled": true,
      "blackout_days_before": 2,
      "blackout_days_after": 1
    },
    "tp_sl_rules": {
      "sl_mode": "NEXT_FIBO_LINE",
      "tp1_mode": "NEXT_FIBO_LINE_LOCK_PROFIT",
      "tp2_mode": "SECOND_FIBO_LINE_RUNNER",
      "lock_profit_ratio_at_tp1": 0.45,
      "force_eod_flush_est": "15:45"
    },
    "option_contract_rules": {
      "min_dte": 1,
      "max_dte": 7,
      "target_abs_delta": 0.58,
      "max_spread_pct": 4.5,
      "default_contracts_under_80": 2,
      "default_contracts_over_80": 1
    }
  },
  "paper_trading": {
    "enabled": true,
    "starting_balance_usd": 5000.0,
    "auto_enter_actionable": true,
    "etf_friction_per_contract_usd": 3.0,
    "stock_friction_per_contract_usd": 5.0
  }
}
